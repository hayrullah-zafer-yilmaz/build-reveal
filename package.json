{
  "name": "build-reveal",
  "version": "0.1.1",
  "description": "Framework-agnostic \"design tool\" reveal animation: virtual cursors draw selection frames around your elements and type their text in.",
  "license": "MIT",
  "author": "Hayrullah Zafer Yılmaz",
  "homepage": "https://hayrullah-zafer-yilmaz.github.io/build-reveal/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayrullah-zafer-yilmaz/build-reveal.git"
  },
  "bugs": {
    "url": "https://github.com/hayrullah-zafer-yilmaz/build-reveal/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/build-reveal.global.js",
  "jsdelivr": "./dist/build-reveal.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite demo",
    "build": "tsup",
    "build:demo": "vite build demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package"
  },
  "keywords": [
    "animation",
    "reveal",
    "scroll-reveal",
    "cursor",
    "typewriter",
    "vanilla",
    "web-component",
    "custom-element",
    "react",
    "vue",
    "angular",
    "svelte"
  ],
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
